[Unit]
Description=CrickAI FastAPI backend
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/crickai
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/ubuntu/.local/bin
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target